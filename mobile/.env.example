# Copy to mobile/.env. Only EXPO_PUBLIC_* values are embedded in the app; never put secrets here.
#
# Spring Boot origin (without /api). A physical phone cannot use localhost:
#   Android emulator:   http://10.0.2.2:8080
#   iOS simulator:      http://localhost:8080
#   Physical device:    http://<your-computer-LAN-IP>:8080   (same Wi-Fi)
#   Production:         https://attendance.example.edu      (HTTPS required)
EXPO_PUBLIC_API_URL=http://192.168.0.109:8080

# development (allows http:// LAN URLs) or production (HTTPS only)
APP_ENV=development
