# Copy to .env and replace every placeholder. Never commit the real .env.
DB_USER=attendance
DB_PASSWORD=change-me-database-password
ADMIN_PASSWORD=change-me-admin-password-min-12
TEACHER_PASSWORD=change-me-teacher-password-min-12
# Shared secret between Spring Boot and the Python service; never given to clients.
AI_SERVICE_KEY=change-me-long-random-internal-key
# Optional: lifetime of mobile sign-in tokens in hours (1–2160, default 168 = 7 days).
MOBILE_TOKEN_TTL_HOURS=168
